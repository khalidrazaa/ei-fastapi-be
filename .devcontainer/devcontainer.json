{
  "name": "Blogging system (FastAPI + Next.js)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "remoteUser": "vscode",
  "forwardPorts": [8000, 3000, 3001],
  "portsAttributes": {
    "8000": { "label": "FastAPI", "onAutoForward": "notify" },
    "3000": { "label": "Public Next.js UI", "onAutoForward": "notify" },
    "3001": { "label": "Admin Next.js UI", "onAutoForward": "notify" }
  },
  "postCreateCommand": ["bash", ".devcontainer/setup.sh"],
  "waitFor": "postCreateCommand",
  "customizations": {
    "codespaces": {
      "repositories": {
        "khalidrazaa/ei-admin-ui-nextjs": { "permissions": { "contents": "read" } },
        "khalidrazaa/ei-ui-nextjs": { "permissions": { "contents": "read" } }
      },
      "openFiles": [".devcontainer/README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff", "dbaeumer.vscode-eslint"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder:ei-fastapi-be}/.venv/bin/python"
      }
    }
  }
}
